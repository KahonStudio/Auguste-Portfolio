# Copy to .env for local (Prisma reads .env, not .env.local).

# --- Neon Postgres ---
# DATABASE_URL = pooled string (hostname contains -pooler)
# DIRECT_URL   = same string with -pooler removed from the hostname
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

ADMIN_EMAIL="admin@localhost.dev"
ADMIN_PASSWORD="changeme"
# Prefer a hash in production:
# ADMIN_PASSWORD_HASH=

# Cloudinary (CMS media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (contact form). Without these, submissions are logged.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
